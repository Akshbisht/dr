{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.12","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"competition","sourceId":14774},{"sourceType":"datasetVersion","sourceId":2822109},{"sourceType":"datasetVersion","sourceId":418031},{"sourceType":"datasetVersion","sourceId":2812287},{"sourceType":"datasetVersion","sourceId":2819730}],"dockerImageVersionId":31329,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":true}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"\"\"\"\nAbsolute SOTA Diabetic Retinopathy Curriculum Pipeline (Exact Paths Edition)\nFeatures: Direct Kaggle Path Routing, Disk Caching, Robust Architecture.\n\"\"\"\n\nimport os\nimport sys\nimport time\nimport datetime\nimport cv2\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\nfrom torch.utils.checkpoint import checkpoint\nfrom torch.cuda.amp import autocast, GradScaler\nimport torchvision.transforms as T\nfrom torchvision.models import convnext_tiny, ConvNeXt_Tiny_Weights\nimport albumentations as A\nfrom albumentations.pytorch import ToTensorV2\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import cohen_kappa_score, accuracy_score, classification_report\nimport warnings\n\nwarnings.filterwarnings(\"ignore\")\n\n# ==========================================\n# 1. MATHEMATICALLY CORRECTED PREPROCESSING\n# ==========================================\ndef crop_to_retina(img, tol=7):\n    gray = cv2.cvtColor(img, cv2.COLOR_RGB2GRAY) if img.ndim == 3 else img\n    mask = gray > tol\n    if not mask.any(): return img\n    return img[np.ix_(mask.any(1), mask.any(0))]\n\ndef advanced_dr_preprocessing(img, target_size=1024):\n    img = crop_to_retina(img)\n    img = cv2.resize(img, (target_size, target_size))\n    \n    lab = cv2.cvtColor(img, cv2.COLOR_RGB2LAB)\n    l, a, b = cv2.split(lab)\n    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))\n    img_clahe = cv2.cvtColor(cv2.merge((clahe.apply(l), a, b)), cv2.COLOR_LAB2RGB)\n    \n    r, g, bl = cv2.split(img_clahe)\n    \n    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (15, 15))\n    top_hat = cv2.morphologyEx(g, cv2.MORPH_TOPHAT, kernel)\n    bottom_hat = cv2.morphologyEx(g, cv2.MORPH_BLACKHAT, kernel)\n    \n    enhanced_g = cv2.add(g, top_hat)\n    enhanced_g = cv2.subtract(enhanced_g, bottom_hat)\n    \n    return cv2.merge((r, enhanced_g, bl)) \n\ndef preprocess_dataset_to_disk(csv_path, img_dir, output_dir, img_col, label_col, extension=\".jpg\"):\n    print(f\"⚙️ [Processing] Saving morphological images to: {output_dir}\")\n    os.makedirs(output_dir, exist_ok=True)\n    df = pd.read_csv(csv_path)\n    processed_paths, processed_labels = [], []\n    \n    # Kaggle output persistence check\n    if os.path.exists(os.path.join(output_dir, f\"{len(df)-1}.jpg\")):\n        print(\"   ✅ Dataset already preprocessed on disk. Skipping...\")\n        for idx, row in df.iterrows():\n            processed_paths.append(os.path.join(output_dir, f\"{idx}.jpg\"))\n            processed_labels.append(row[label_col])\n        return pd.DataFrame({'image_path': processed_paths, 'diagnosis': processed_labels})\n    \n    for idx, row in df.iterrows():\n        img_name = str(row[img_col])\n        if not img_name.endswith(extension) and not img_name.endswith('.jpg') and not img_name.endswith('.jpeg'): \n            img_name += extension\n        out_path = os.path.join(output_dir, f\"{idx}.jpg\")\n        \n        if not os.path.exists(out_path):\n            raw_img_path = os.path.join(img_dir, img_name)\n            \n            # --- ROBUST PATH FALLBACK FOR NESTED KAGGLE DATASETS ---\n            if not os.path.exists(raw_img_path):\n                # Try nested resized_train folder (common Kaggle dataset quirk)\n                nested_path = os.path.join(img_dir, 'resized_train', img_name)\n                if os.path.exists(nested_path):\n                    raw_img_path = nested_path\n                else:\n                    # Try changing extension from .jpeg to .jpg or vice versa\n                    alt_ext = '.jpg' if extension == '.jpeg' else '.jpeg'\n                    alt_name = str(row[img_col])\n                    if not alt_name.endswith(alt_ext):\n                        alt_name += alt_ext\n                    \n                    if os.path.exists(os.path.join(img_dir, alt_name)):\n                        raw_img_path = os.path.join(img_dir, alt_name)\n                    elif os.path.exists(os.path.join(img_dir, 'resized_train', alt_name)):\n                        raw_img_path = os.path.join(img_dir, 'resized_train', alt_name)\n\n            img = cv2.imread(raw_img_path)\n            if img is not None:\n                proc_img = advanced_dr_preprocessing(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))\n                # SAVE AS HIGH-QUALITY JPEG INSTEAD OF PNG TO BYPASS 19GB LIMIT\n                cv2.imwrite(out_path, cv2.cvtColor(proc_img, cv2.COLOR_RGB2BGR), [int(cv2.IMWRITE_JPEG_QUALITY), 95])\n            else:\n                if (idx + 1) % 1000 == 0: # Only print occasionally to avoid spam\n                    print(f\"   ⚠️ Warning: Could not read image at {raw_img_path}\")\n        \n        if os.path.exists(out_path):\n            processed_paths.append(out_path)\n            processed_labels.append(row[label_col])\n            \n        if (idx + 1) % 1000 == 0:\n            print(f\"   ➤ Processed {idx + 1}/{len(df)} images...\")\n            \n    return pd.DataFrame({'image_path': processed_paths, 'diagnosis': processed_labels})\n\n# ==========================================\n# 2. ARCHITECTURE (FIXED 384 CHANNELS)\n# ==========================================\ndef get_transforms(image_size=1024, is_train=True):\n    if is_train:\n        return A.Compose([\n            A.HorizontalFlip(p=0.5), A.VerticalFlip(p=0.5),\n            A.ShiftScaleRotate(shift_limit=0.05, scale_limit=0.1, rotate_limit=45, p=0.5),\n            A.CoarseDropout(max_holes=8, max_height=image_size//10, max_width=image_size//10, p=0.2),\n            A.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)), ToTensorV2(),\n        ])\n    return A.Compose([A.Normalize(mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225)), ToTensorV2()])\n\nclass DRDiskDataset(Dataset):\n    def __init__(self, df, transform=None):\n        self.df, self.transform = df, transform\n    def __len__(self): return len(self.df)\n    def __getitem__(self, idx):\n        img = cv2.cvtColor(cv2.imread(self.df.iloc[idx]['image_path']), cv2.COLOR_BGR2RGB)\n        return self.transform(image=img)['image'] if self.transform else img, torch.tensor(self.df.iloc[idx]['diagnosis'], dtype=torch.long)\n\nclass SimplifiedStateSpaceBlock(nn.Module):\n    def __init__(self, d):\n        super().__init__()\n        self.p_in, self.c2d, self.act = nn.Conv2d(d, d*2, 1), nn.Conv2d(d*2, d*2, 3, 1, 1, groups=d*2), nn.SiLU()\n        self.sg, self.p_out = nn.Conv2d(d*2, d*2, 1), nn.Conv2d(d*2, d, 1)\n    def forward(self, x): return self.p_out(self.act(self.c2d(self.p_in(x))) * torch.sigmoid(self.sg(self.act(self.c2d(self.p_in(x)))))) + x\n\nclass StableSlotAttention(nn.Module):\n    def __init__(self, n, d, iters=2):\n        super().__init__()\n        self.n, self.iters, self.scale = n, iters, d**-0.5\n        self.mu, self.lgs = nn.Parameter(torch.randn(1, 1, d)), nn.Parameter(torch.zeros(1, 1, d))\n        self.q, self.k, self.v = nn.Linear(d, d), nn.Linear(d, d), nn.Linear(d, d)\n        self.gru, self.mlp = nn.GRUCell(d, d), nn.Sequential(nn.Linear(d, d*4), nn.ReLU(inplace=True), nn.Dropout(0.2), nn.Linear(d*4, d))\n        self.n_in, self.n_s, self.n_ff = nn.LayerNorm(d), nn.LayerNorm(d), nn.LayerNorm(d)\n        \n    def forward(self, x):\n        b, _, d = x.shape\n        k, v, s = self.k(self.n_in(x)), self.v(self.n_in(x)), self.mu.expand(b, self.n, -1) + self.lgs.exp().expand(b, self.n, -1) * torch.randn_like(self.mu.expand(b, self.n, -1))\n        for _ in range(self.iters):\n            sp, q = s, self.q(self.n_s(s))\n            attn = (torch.einsum('bid,bjd->bij', q, k) * self.scale).softmax(dim=1) + 1e-8\n            s = s + self.mlp(self.n_ff(self.gru(torch.einsum('bjd,bij->bid', v, attn / attn.sum(dim=-1, keepdim=True)).reshape(-1, d), sp.reshape(-1, d)).reshape(b, -1, d)))\n        return s\n\nclass RobustGCN(nn.Module):\n    def __init__(self, dim):\n        super().__init__()\n        self.weight = nn.Parameter(torch.Tensor(dim, dim))\n        nn.init.xavier_uniform_(self.weight)\n        self.dropout, self.norm = nn.Dropout(0.3), nn.LayerNorm(dim)\n        \n    def forward(self, nodes):\n        adj = F.softmax(torch.bmm(nodes, nodes.transpose(1, 2)), dim=-1)\n        out = self.dropout(F.relu(torch.matmul(torch.bmm(adj, nodes), self.weight)))\n        return self.norm(out + nodes)\n\nclass SotaDRModel(nn.Module):\n    def __init__(self, num_classes=5, num_slots=8, dim=384):\n        super().__init__()\n        self.stem = nn.Sequential(*list(convnext_tiny(weights=ConvNeXt_Tiny_Weights.DEFAULT).features.children())[:4]) \n        self.ssm, self.proj = SimplifiedStateSpaceBlock(384), nn.Conv2d(384, dim, 1)\n        self.slots, self.gnn = StableSlotAttention(num_slots, dim), RobustGCN(dim)\n        self.pool = nn.AdaptiveAvgPool1d(1)\n        self.evidential_head = nn.Sequential(nn.Linear(dim, dim // 2), nn.ReLU(), nn.Dropout(0.4), nn.Linear(dim // 2, num_classes), nn.Softplus())\n\n    def forward(self, x):\n        x = self.proj(checkpoint(self.ssm, checkpoint(self.stem, x, use_reentrant=False), use_reentrant=False))\n        b, c, h, w = x.shape\n        x = x.view(b, c, h * w).permute(0, 2, 1) \n        return self.evidential_head(self.pool(self.gnn(checkpoint(self.slots, x, use_reentrant=False)).transpose(1, 2)).squeeze(-1)) + 1.0\n\n# ==========================================\n# 3. LOSSES\n# ==========================================\ndef kl_divergence(alpha, num_classes):\n    beta, S_alpha = torch.ones([1, num_classes], dtype=torch.float32, device=alpha.device), torch.sum(alpha, dim=1, keepdim=True)\n    return torch.sum((alpha - beta) * (torch.digamma(alpha) - torch.digamma(S_alpha)), dim=1, keepdim=True) + torch.lgamma(S_alpha) - torch.sum(torch.lgamma(alpha), dim=1, keepdim=True) + torch.sum(torch.lgamma(beta), dim=1, keepdim=True) - torch.lgamma(torch.sum(beta, dim=1, keepdim=True))\n\ndef soft_qwk_loss(alpha, labels, num_classes=5):\n    probs, y = alpha / torch.sum(alpha, dim=1, keepdim=True), F.one_hot(labels, num_classes=num_classes).float()\n    w = torch.tensor([[(i - j) ** 2 / (num_classes - 1) ** 2 for j in range(num_classes)] for i in range(num_classes)], device=alpha.device)\n    return 1.0 - (torch.sum(w * torch.matmul(y.t(), probs)) / (torch.sum(w * (torch.outer(torch.sum(y, dim=0), torch.sum(probs, dim=0)) / (labels.shape[0] + 1e-8))) + 1e-8))\n\ndef evidential_mse_loss(alpha, labels, num_classes=5, global_step=0, annealing_step=10):\n    y, S = F.one_hot(labels, num_classes=num_classes).float(), torch.sum(alpha, dim=1, keepdim=True)\n    return torch.mean(torch.sum((y - (alpha / S)) ** 2, dim=1, keepdim=True) + torch.sum(alpha * (S - alpha) / (S * S * (S + 1)), dim=1, keepdim=True) + min(1.0, global_step / annealing_step) * kl_divergence(y + (1 - y) * alpha, num_classes))\n\n# ==========================================\n# 4. DYNAMIC LOSS BALANCING LOOP\n# ==========================================\ndef train_phase(model, train_loader, val_loader, optimizer, scaler, epochs, phase_name, device):\n    print(f\"\\n=======================================================\")\n    print(f\"🚀 STARTING PHASE: {phase_name} ({epochs} Epochs)\")\n    print(f\"=======================================================\")\n    \n    start_epoch, best_qwk, global_step = 0, -1.0, 0\n    grad_accum_steps = 8\n    \n    # Save checkpoints to Kaggle's working directory so they persist\n    save_dir = \"/kaggle/working/DR_Preprocessed_Data\"\n    os.makedirs(save_dir, exist_ok=True)\n    last_ckpt_path = f'{save_dir}/sota_dr_{phase_name}_last.pth'\n    \n    if os.path.exists(last_ckpt_path):\n        print(f\"🔄 Checkpoint found! Resuming {phase_name}...\")\n        checkpoint_data = torch.load(last_ckpt_path, map_location=device)\n        model.load_state_dict(checkpoint_data['model_state_dict'])\n        optimizer.load_state_dict(checkpoint_data['optimizer_state_dict'])\n        scaler.load_state_dict(checkpoint_data['scaler_state_dict'])\n        start_epoch, best_qwk = checkpoint_data['epoch'] + 1, checkpoint_data['best_qwk']\n        global_step = checkpoint_data.get('global_step', 0)\n        \n    if start_epoch >= epochs: return best_qwk\n    \n    for epoch in range(start_epoch, epochs):\n        start_time, train_loss = time.time(), 0.0\n        train_preds, train_targets = [], []\n        model.train()\n        \n        qwk_weight = min(5.0, 0.5 + (epoch / epochs) * 4.5) \n        \n        for batch_idx, (images, labels) in enumerate(train_loader):\n            images, labels = images.to(device), labels.to(device)\n            \n            with autocast():\n                alpha = model(images)\n                loss_e = evidential_mse_loss(alpha, labels, 5, global_step)\n                loss_q = soft_qwk_loss(alpha, labels)\n                total_loss = (loss_e + qwk_weight * loss_q) / grad_accum_steps\n                \n            scaler.scale(total_loss).backward()\n            train_loss += total_loss.item() * grad_accum_steps\n            \n            with torch.no_grad():\n                probs = alpha / torch.sum(alpha, dim=1, keepdim=True)\n                train_preds.extend(torch.argmax(probs, dim=1).cpu().numpy())\n                train_targets.extend(labels.cpu().numpy())\n            \n            if (batch_idx + 1) % grad_accum_steps == 0 or (batch_idx + 1) == len(train_loader):\n                scaler.unscale_(optimizer)\n                torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n                scaler.step(optimizer)\n                scaler.update()\n                optimizer.zero_grad()\n                global_step += 1\n            \n            if (batch_idx + 1) % 100 == 0 or (batch_idx + 1) == len(train_loader):\n                print(f\"   ➤ Batch [{batch_idx+1}/{len(train_loader)}] - Loss: {total_loss.item()*grad_accum_steps:.4f}\")\n                \n        epoch_time = time.time() - start_time\n        print(f\"\\n⌛ Time: {epoch_time:.0f}s | 📉 Train Loss: {train_loss/len(train_loader):.4f} | 🎯 Train Acc: {accuracy_score(train_targets, train_preds):.4f}\")\n        \n        # --- VALIDATION ---\n        model.eval()\n        val_preds, val_targets = [], []\n        with torch.no_grad():\n            for images, labels in val_loader:\n                alpha = model(images.to(device))\n                probs = alpha / torch.sum(alpha, dim=1, keepdim=True)\n                val_preds.extend(torch.argmax(probs, dim=1).cpu().numpy())\n                val_targets.extend(labels.cpu().numpy())\n                \n        val_acc, val_qwk = accuracy_score(val_targets, val_preds), cohen_kappa_score(val_targets, val_preds, weights='quadratic')\n        print(f\"📊 Val Acc: {val_acc:.4f} | Val QWK: {val_qwk:.4f}\")\n        print(classification_report(val_targets, val_preds, digits=4, zero_division=0))\n        \n        # Save checkpoints directly to Kaggle output dir\n        torch.save({'epoch': epoch, 'model_state_dict': model.state_dict(), 'optimizer_state_dict': optimizer.state_dict(), 'scaler_state_dict': scaler.state_dict(), 'best_qwk': best_qwk, 'global_step': global_step}, last_ckpt_path)\n        \n        if val_qwk > best_qwk:\n            best_qwk = val_qwk\n            torch.save(model.state_dict(), f'{save_dir}/sota_dr_{phase_name}_best.pth')\n            print(f\"🌟 New SOTA Saved (QWK: {val_qwk:.4f}) 🌟\")\n            \n    return best_qwk\n\n# ==========================================\n# 5. MAIN EXECUTION (MULTI-DATASET VAL)\n# ==========================================\ndef main():\n    print(\"🔥 INITIALIZING MATHEMATICALLY ROBUST SOTA DR PIPELINE 🔥\")\n\n    # 1. EXACT KAGGLE PATHS PROVIDED BY USER\n    aptos_img = '/kaggle/input/competitions/aptos2019-blindness-detection/train_images'\n    aptos_csv = '/kaggle/input/competitions/aptos2019-blindness-detection/train.csv'\n    eyepacs_img = '/kaggle/input/datasets/tanlikesmath/diabetic-retinopathy-resized/resized_train'\n    eyepacs_csv = '/kaggle/input/datasets/tanlikesmath/diabetic-retinopathy-resized/trainLabels.csv'\n\n    # Sanity Check to ensure everything is connected properly\n    for p in [aptos_img, aptos_csv, eyepacs_img, eyepacs_csv]:\n        if not os.path.exists(p):\n            print(f\"🚨 ERROR: Path not found: {p}\")\n            print(\"Please ensure both datasets are attached to this Notebook session.\")\n            sys.exit(1)\n            \n    print(\"✅ All Exact Kaggle Dataset Paths Verified Successfully.\")\n\n    # Save directly to Kaggle Working Directory (This persists when you Save Version)\n    base_out = \"/kaggle/working/DR_Preprocessed_Data\"\n    \n    df_eyepacs = preprocess_dataset_to_disk(eyepacs_csv, eyepacs_img, f\"{base_out}/eyepacs\", 'image', 'level', '.jpeg')\n    df_aptos = preprocess_dataset_to_disk(aptos_csv, aptos_img, f\"{base_out}/aptos\", 'id_code', 'diagnosis', '.jpg')\n\n    print(\"\\n🔀 [Splitting] Creating separate 10% Validation Splits...\")\n    train_eyepacs_df, val_eyepacs_df = train_test_split(df_eyepacs, test_size=0.10, stratify=df_eyepacs['diagnosis'], random_state=42)\n    train_aptos_df, val_aptos_df = train_test_split(df_aptos, test_size=0.10, stratify=df_aptos['diagnosis'], random_state=42)\n    \n    print(f\"   ➤ EyePACS Train: {len(train_eyepacs_df)} | EyePACS Val: {len(val_eyepacs_df)}\")\n    print(f\"   ➤ APTOS Train: {len(train_aptos_df)} | APTOS Val: {len(val_aptos_df)}\")\n    \n    DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n    model = SotaDRModel().to(DEVICE)\n    scaler = GradScaler()\n    \n    def build_loader(df, is_train):\n        dataset = DRDiskDataset(df, transform=get_transforms(is_train=is_train))\n        if is_train:\n            w = 1.0 / df['diagnosis'].value_counts().sort_index().values\n            sampler = WeightedRandomSampler([w[l] for l in df['diagnosis']], len(df), replacement=True)\n            return DataLoader(dataset, batch_size=2, sampler=sampler, num_workers=2, pin_memory=True)\n        return DataLoader(dataset, batch_size=2, shuffle=False, num_workers=2, pin_memory=True)\n\n    val_loader_eyepacs = build_loader(val_eyepacs_df, False)\n    val_loader_aptos = build_loader(val_aptos_df, False)\n\n    # PHASE 1: EyePACS Representation Learning\n    opt_p1 = torch.optim.AdamW(model.parameters(), lr=1e-4, weight_decay=1e-2)\n    train_phase(model, build_loader(train_eyepacs_df, True), val_loader_eyepacs, opt_p1, scaler, 15, \"Phase1_EyePACS\", DEVICE)\n\n    # PHASE 2: APTOS Precision Reasoning\n    print(\"\\n🔄 Preparing for Phase 2: Loading best Phase 1 weights...\")\n    best_p1_path = f'{base_out}/sota_dr_Phase1_EyePACS_best.pth'\n    if os.path.exists(best_p1_path): \n        model.load_state_dict(torch.load(best_p1_path, map_location=DEVICE))\n        print(\"✅ Successfully loaded weights from Phase 1.\")\n    else:\n        print(\"⚠️ Warning: Could not find Phase 1 best model. Training Phase 2 from scratch.\")\n        \n    # Freeze stem to keep general retinal features learned from the massive EyePACS dataset\n    for param in model.stem.parameters(): param.requires_grad = False\n    \n    opt_p2 = torch.optim.AdamW(filter(lambda p: p.requires_grad, model.parameters()), lr=1e-5, weight_decay=1e-3)\n    train_phase(model, build_loader(train_aptos_df, True), val_loader_aptos, opt_p2, scaler, 15, \"Phase2_APTOS\", DEVICE)\n\nif __name__ == \"__main__\":\n    main()","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2026-07-08T08:28:26.139005Z","iopub.execute_input":"2026-07-08T08:28:26.139881Z","iopub.status.idle":"2026-07-08T08:59:35.502967Z","shell.execute_reply.started":"2026-07-08T08:28:26.139839Z","shell.execute_reply":"2026-07-08T08:59:35.501426Z"}},"outputs":[{"name":"stdout","text":"🔥 INITIALIZING MATHEMATICALLY ROBUST SOTA DR PIPELINE 🔥\n✅ All Exact Kaggle Dataset Paths Verified Successfully.\n⚙️ [Processing] Saving morphological images to: /kaggle/working/DR_Preprocessed_Data/eyepacs\n   ➤ Processed 1000/35126 images...\n   ➤ Processed 2000/35126 images...\n   ➤ Processed 3000/35126 images...\n   ➤ Processed 4000/35126 images...\n   ➤ Processed 5000/35126 images...\n   ➤ Processed 6000/35126 images...\n   ➤ Processed 7000/35126 images...\n   ➤ Processed 8000/35126 images...\n   ➤ Processed 9000/35126 images...\n   ➤ Processed 10000/35126 images...\n   ➤ Processed 11000/35126 images...\n   ➤ Processed 12000/35126 images...\n   ➤ Processed 13000/35126 images...\n   ➤ Processed 14000/35126 images...\n   ➤ Processed 15000/35126 images...\n   ➤ Processed 16000/35126 images...\n   ➤ Processed 17000/35126 images...\n   ➤ Processed 18000/35126 images...\n   ➤ Processed 19000/35126 images...\n   ➤ Processed 20000/35126 images...\n   ➤ Processed 21000/35126 images...\n   ➤ Processed 22000/35126 images...\n   ➤ Processed 23000/35126 images...\n   ➤ Processed 24000/35126 images...\n   ➤ Processed 25000/35126 images...\n   ➤ Processed 26000/35126 images...\n   ➤ Processed 27000/35126 images...\n   ➤ Processed 28000/35126 image